<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".TextActivity">

    <TextView
        android:id="@+id/before"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:layout_toLeftOf="@id/cD_row"
        android:gravity="right"
        android:textSize="8sp"
        tools:ignore="RtlHardcoded,SmallSp"
        android:text="@string/dateInsert"/>

    <TextView
        android:id="@+id/cD_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="5dp"
        android:gravity="right"
        android:textSize="8sp"
        tools:ignore="RtlHardcoded,SmallSp" />

    <TextView
        android:id="@+id/titlePage"
        android:layout_below="@id/cD_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="15dp"
        android:gravity="center"
        android:textColor="@color/text"
        android:textSize="25sp" />

    <TextView
        android:id="@+id/textArticle"
        android:layout_below="@id/titlePage"
        android:layout_marginTop="10dp"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:paddingHorizontal="15dp"
        android:textSize="18sp" />


    <Button
        android:id="@+id/buttonEdit"
        android:layout_below="@id/textArticle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:layout_marginStart="40sp"
        android:textColor="@color/btn"
        android:text="@string/btnRewrite" />

    <Button
        android:id="@+id/buttonDelete"
        android:layout_below="@id/textArticle"
        android:layout_alignParentEnd="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="40sp"
        android:layout_marginTop="30dp"
        android:textColor="@color/btn"
        android:text="@string/btnDelete" />

    <TextView
        android:id="@+id/toAutorization"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/buttonEdit"
        android:layout_marginTop="10dp"
        android:layout_centerHorizontal="true"
        android:textColor="@color/link"
        android:text="@string/toAuth" />
</RelativeLayout>