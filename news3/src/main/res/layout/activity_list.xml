<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/list_links"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/before"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_toLeftOf="@id/autor_row"
        android:gravity="right"
        android:textSize="8sp"
        tools:ignore="RtlHardcoded,SmallSp"
        android:text="@string/dateInsert"/>

    <TextView
        android:id="@+id/autor_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toLeftOf="@id/cD_row"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="5dp"
        android:gravity="right"
        android:textSize="8sp"
        tools:ignore="RtlHardcoded,SmallSp" />

    <TextView
        android:id="@+id/cD_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="5dp"
        android:gravity="right"
        android:textSize="8sp"
        tools:ignore="RtlHardcoded,SmallSp" />

    <TextView
        android:id="@+id/title_row"
        android:layout_below="@id/cD_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:layout_marginHorizontal="15dp"
        android:gravity="center_vertical"
        android:textColor="@color/title"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/intro_row"
        android:layout_below="@id/title_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginHorizontal="5dp"
        android:gravity="center_vertical"
        android:textColor="@color/white"
        android:textSize="13sp"
        tools:ignore="SmallSp" />

</RelativeLayout>