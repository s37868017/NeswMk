<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Authorization">
    
    <Button
        android:id="@+id/auth_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="70dp"
        android:textColor="@color/btn"
        android:layout_below="@id/editPassword"
        android:text="@string/btnAuth" />

    <EditText
        android:id="@+id/editLogin"
        android:layout_below="@id/title"
        android:layout_width="match_parent"
        android:layout_height="40sp"
        android:textAlignment="center"
        android:hint="@string/hintLogin"
        android:layout_marginTop="40dp"
        android:layout_marginHorizontal="15dp"
        android:layout_centerHorizontal="true" />

    <EditText
        android:id="@+id/editPassword"
        android:layout_below="@id/editLogin"
        android:layout_width="match_parent"
        android:layout_height="40sp"
        android:textAlignment="center"
        android:hint="@string/hintPassword"
        android:inputType="textWebPassword"
        android:layout_marginTop="30sp"
        android:layout_marginHorizontal="15dp"
        android:layout_centerHorizontal="true" />

    <TextView
        android:id="@+id/toReg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/auth_btn"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="25dp"
        android:textColor="@color/link"
        android:text="@string/btnReg" />

    <TextView
        android:id="@+id/title"
        android:layout_below="@id/toMain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="25dp"
        android:textSize="25sp"
        android:text="@string/titleAuth" />

    <TextView
        android:id="@+id/toMain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="25dp"
        android:layout_marginTop="45dp"
        android:textColor="@color/link"
        android:textSize="15sp"
        android:text="@string/toMain" />

</RelativeLayout>