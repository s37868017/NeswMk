<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_nameMk"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SQL_Connect"
        android:usesCleartextTraffic="true"
        tools:targetApi="36">
        <activity
            android:name=".ShowUser"
            android:exported="false"
            android:label="ShowUser"
            android:theme="@style/Theme.SQL_Connect">
            <intent-filter>
                <action android:name="com.newsMk.ShowUser" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".AdminPanel"
            android:exported="false"
            android:label="AdminPanel"
            android:theme="@style/Theme.SQL_Connect">
            <intent-filter>
                <action android:name="com.newsMk.AdminPanel" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".Authorization"
            android:exported="false"
            android:label="Authorization"
            android:noHistory="true"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.SQL_Connect">
            <intent-filter>
                <action android:name="com.newsMk.Authorization" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".RegAuth"
            android:exported="false"
            android:label="RegAuth"
            android:theme="@style/Theme.SQL_Connect">
            <intent-filter>
                <action android:name="com.newsMk.RegAuth" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".EditActivity"
            android:exported="false"
            android:label="EditActivity"
            android:theme="@style/Theme.SQL_Connect">
            <intent-filter>
                <action android:name="com.newsMk.EditActivity" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".TextActivity"
            android:exported="false"
            android:label="TextActivity"
            android:theme="@style/Theme.SQL_Connect">
            <intent-filter>
                <action android:name="com.newsMk.TextActivity" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".SentActivity"
            android:exported="false"
            android:label="@string/title_activity_sent"
            android:theme="@style/Theme.SQL_Connect">
            <intent-filter>
                <action android:name="com.newsMk.SentActivity" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>